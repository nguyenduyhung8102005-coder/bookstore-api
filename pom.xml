<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Kế thừa spring-boot-starter-parent để Spring Boot quản lý version cho
        hàng trăm thư viện (Hibernate, Jackson, Flyway, Testcontainers...).
        Nhờ vậy các dependency bên dưới không cần ghi <version>.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.nguyenduyhung</groupId>
    <artifactId>bookstore-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>bookstore-api</name>
    <description>REST API cho hệ thống bán sách trực tuyến</description>

    <properties>
        <java.version>21</java.version>
        <!-- springdoc không nằm trong BOM của Spring Boot nên phải tự khai báo version -->
        <springdoc.version>2.8.9</springdoc.version>
        <!--
            Docker Engine 29 (có trong Docker Desktop mới) nâng phiên bản API tối
            thiểu, khiến Testcontainers 1.x đời cũ báo "Could not find a valid
            Docker environment". 1.21.4 là bản 1.x đã vá lỗi này.
        -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <!-- jjwt không nằm trong BOM của Spring Boot -->
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencies>
        <!-- ===== Web & Validation ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ===== Bảo mật ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!--
            jjwt tách làm 3 phần: code của ta chỉ được phụ thuộc vào "api"
            (compile); phần cài đặt "impl" và bộ đọc JSON "jackson" chỉ cần lúc
            chạy (runtime). Nhờ vậy ta không vô tình dùng class nội bộ của thư viện.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== Database ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Từ Flyway 10, hỗ trợ từng loại DB được tách thành module riêng -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== Tài liệu API & giám sát ===== -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===== Tiện ích ===== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===== Test ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Chặn build ngay từ đầu nếu Maven đang chạy bằng JDK khác 21.
                Lý do: Lombok móc vào trình biên dịch (javac) của chính JDK đang
                chạy Maven, nên `<java.version>21</java.version>` KHÔNG đủ để
                bảo vệ. JDK quá mới làm Lombok vỡ với lỗi khó hiểu (ví dụ
                ExceptionInInitializerError: ...EndPosTable). Rule này biến lỗi
                đó thành một câu thông báo rõ ràng.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-java-21</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                    <message>Du an nay can JDK 21. Hay tro JAVA_HOME toi JDK 21 roi chay lai (kiem tra bang: mvn -v).</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
                Goal "properties" tạo ra property trỏ tới file jar của từng
                dependency, ví dụ ${org.mockito:mockito-core:jar}. Dùng ở dưới để
                nạp Mockito như một javaagent.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                Surefire (có sẵn) chạy unit test: các class tên *Test.
                Failsafe chạy integration test: các class tên *IT, ở pha
                "integration-test" khi gọi `mvn verify`. Tách ra để chạy unit
                test nhanh bằng `mvn test` mà không cần Docker.

                argLine: nạp Mockito làm javaagent ngay khi JVM test khởi động,
                thay vì để Mockito tự gắn agent lúc chạy (JDK 21 cảnh báo việc này
                và các JDK sau sẽ chặn). -Xshare:off tắt cảnh báo CDS đi kèm.
                Lưu ý cho GĐ 8: khi thêm JaCoCo phải đổi thành "@{argLine} ...".
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
